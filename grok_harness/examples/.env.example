# --- Keycloak (IdP inside the GCP Assured Workload) ---
GH_KEYCLOAK_ISSUER=https://keycloak.svc.agency.gov/realms/il5
GH_KEYCLOAK_CLIENT_ID=grok-harness
GH_KEYCLOAK_AUDIENCE=api://AzureADTokenExchange
# Projected K8s SA token is the default; set if you use a different path.
# GH_WORKLOAD_TOKEN_PATH=/var/run/secrets/tokens/azure-federation
# Optional: override if your realm uses a non-standard token-exchange URL.
# GH_KEYCLOAK_TOKEN_EXCHANGE_URL=https://keycloak.svc.agency.gov/realms/il5/protocol/openid-connect/token

# --- Azure AD (Government tenant) ---
GH_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
GH_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
GH_AZURE_RESOURCE_SCOPE=api://grok-prod/.default
GH_AZURE_AUTHORITY=https://login.microsoftonline.us

# --- Grok 4.3 (Azure Government inference) ---
GH_GROK_ENDPOINT=https://grok-43.eastus2.inference.ml.azure.us
GH_GROK_DEPLOYMENT=grok-4.3
GH_GROK_API_VERSION=2024-12-01-preview

# --- Transport / FIPS ---
GH_CA_BUNDLE=/etc/ssl/certs/agency-pki-bundle.pem
GH_ENFORCE_TLS13=true
GH_ENFORCE_FIPS=true

# --- Audit ---
GH_AUDIT_LOG_PATH=/var/log/grok-harness/audit.jsonl

# --- Execution ---
GH_MAX_CONCURRENCY=4
