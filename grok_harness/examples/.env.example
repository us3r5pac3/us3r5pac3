# ============================================================================
# Auth mode — pick one. Default is keycloak_federated (the IL5 GCP path).
# ============================================================================
# GH_AUTH_MODE=keycloak_federated         # IL5 production (GCP -> Keycloak -> Azure)
# GH_AUTH_MODE=client_secret              # Service principal w/ shared secret (Azure dev/CI)
# GH_AUTH_MODE=managed_identity           # Azure VM / App Service / legacy AKS
# GH_AUTH_MODE=azure_workload_identity    # Modern AKS with azwi
# GH_AUTH_MODE=static_bearer              # Pre-acquired Azure AD token (interactive dev)
# GH_AUTH_MODE=api_key                    # DEV ONLY: plain API key vs commercial Azure-hosted Grok

# ============================================================================
# Always required — Azure tenant + Grok 4.3 deployment.
# ============================================================================
GH_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
GH_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
GH_AZURE_RESOURCE_SCOPE=api://grok-prod/.default
GH_AZURE_AUTHORITY=https://login.microsoftonline.us
GH_GROK_ENDPOINT=https://grok-43.eastus2.inference.ml.azure.us
GH_GROK_DEPLOYMENT=grok-4.3
GH_GROK_API_VERSION=2024-12-01-preview

# ============================================================================
# Per-auth-mode fields. Fill in the block that matches GH_AUTH_MODE.
# ============================================================================

# --- keycloak_federated (IL5 GCP caller) ---
# GH_KEYCLOAK_ISSUER=https://keycloak.svc.agency.gov/realms/il5
# GH_KEYCLOAK_CLIENT_ID=grok-harness
# GH_KEYCLOAK_AUDIENCE=api://AzureADTokenExchange
# GH_WORKLOAD_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
# GH_KEYCLOAK_TOKEN_EXCHANGE_URL=  # optional override

# --- client_secret (Grok team: simplest path inside Azure) ---
# GH_AZURE_CLIENT_SECRET=...  # source from Key Vault, never commit

# --- managed_identity (Azure VM / App Service / legacy AKS) ---
# GH_AZURE_MANAGED_IDENTITY_CLIENT_ID=  # omit for system-assigned
# GH_AZURE_IMDS_ENDPOINT=               # override for App Service IDENTITY_ENDPOINT

# --- azure_workload_identity (modern AKS) ---
# GH_AZURE_WORKLOAD_TOKEN_PATH=/var/run/secrets/azure/tokens/azure-identity-token

# --- static_bearer (interactive dev only) ---
# GH_AZURE_STATIC_BEARER=eyJ0eXAi...  # from `az account get-access-token --resource api://grok-prod`

# --- api_key (DEV ONLY: commercial Azure-hosted Grok endpoint) ---
# Use against a non-prod Azure AI Foundry MaaS deployment. NOT IL5-compliant.
# The key is sent as the `api-key` header (Azure OpenAI / Foundry convention).
# Pair with: GH_ENFORCE_FIPS=false, GH_AZURE_AUTHORITY=https://login.microsoftonline.com,
#            GH_GROK_ENDPOINT=<your commercial endpoint>.
# GH_AZURE_API_KEY=...

# ============================================================================
# Transport / FIPS. Leave on for IL5; safe to disable for local dev.
# ============================================================================
# GH_CA_BUNDLE=/etc/ssl/certs/agency-pki-bundle.pem
GH_ENFORCE_TLS13=true
GH_ENFORCE_FIPS=true

# ============================================================================
# Audit + execution.
# ============================================================================
GH_AUDIT_LOG_PATH=/var/log/grok-harness/audit.jsonl
GH_MAX_CONCURRENCY=4
